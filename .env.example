# Copy to .env and edit. No exchange/trading keys are used anywhere — paper trading only.

# --- LLM (optional) ---------------------------------------------------------
# Without a key, the Scout and Devil's Advocate run the transparent rule engine (rules:v1), labelled in the UI.
ANTHROPIC_API_KEY=
AQ_LLM_MODEL=claude-opus-5-5
AQ_LLM_EFFORT=medium
# Server-side refusal fallback (beta). Automatically retried without it if the API rejects the parameter.
AQ_LLM_FALLBACKS=true
# Hard cap on Claude calls per UTC day; beyond it the agents use rules:v1 (labelled in the UI).
AQ_MAX_LLM_CALLS_PER_DAY=60

# --- Data -------------------------------------------------------------------
# Market data providers need no keys. Order = priority.
AQ_PROVIDERS=binance,coinbase
AQ_UNIVERSE=BTC,ETH,SOL,BNB,XRP,DOGE
AQ_DB_PATH=./data/adaptive_quant.db

# --- Fund & risk engine (experiment parameters, not optimal values) -----------
AQ_STARTING_CAPITAL=10000
AQ_MAX_RISK_PER_TRADE_PCT=0.5
AQ_MAX_OPEN_POSITIONS=3
AQ_MAX_PORTFOLIO_EXPOSURE_PCT=30
AQ_MIN_REWARD_RISK=1.5
AQ_DAILY_LOSS_LIMIT_PCT=2
# UK retail cannot access crypto derivatives (FCA ban, 2021), so a UK-realistic fund is buy-only.
AQ_ALLOW_SHORT=false
AQ_TRADE_ON_MONITOR_VERDICT=false

# --- Cost assumptions (basis points per side) ---------------------------------
# 10 bps ~ low-cost venue taker fee. Retail Coinbase can be 40-120 bps: raise if that is your venue.
AQ_FEE_BPS_PER_SIDE=10
# Slippage is estimated by walking the live L2 order book for the intended size; this flat value is the fallback.
AQ_USE_ORDER_BOOK=true
AQ_SLIPPAGE_BPS_PER_SIDE=10
AQ_MIN_SLIPPAGE_BPS_PER_SIDE=2
# Shorts: cost from the Binance perp funding rate (income ignored); this per-day value is the fallback.
AQ_SHORT_BORROW_BPS_PER_DAY=5

# --- Automated monitor ------------------------------------------------------
AQ_MONITOR_ENABLED=true
AQ_MONITOR_INTERVAL_MINUTES=15
AQ_INVESTIGATION_COOLDOWN_MINUTES=240
AQ_MAX_INVESTIGATIONS_PER_RUN=2
AQ_TRIGGER_ABS_Z_4H=2.5
AQ_TRIGGER_VOLUME_RATIO_4H=2.5
AQ_TRIGGER_VOL_REGIME_RATIO=1.8
AQ_TRIGGER_RANGE_BREAKOUT=true

# --- Experience memory (similar past trades shown to agents) ------------------
AQ_MEMORY_K=5
AQ_MEMORY_MIN_SIMILAR=5

# --- Learning / analytics gates ----------------------------------------------
AQ_LESSON_MIN_EVIDENCE=10
AQ_MIN_TRADES_FOR_METRICS=20
AQ_MIN_DAYS_FOR_SHARPE=30

# --- Deployment ---------------------------------------------------------------
# Set a password before exposing the server to the internet (browser login: user "admin").
AQ_DASHBOARD_PASSWORD=
# true = anyone can view the dashboard, only the password holder can run investigations / close trades.
AQ_PUBLIC_READ_ONLY=false
# Comma-separated origins allowed to call the API from another site (e.g. a Lovable frontend).
AQ_CORS_ORIGINS=
# AQ_HOST=0.0.0.0 to listen on all interfaces (set automatically in the Docker image).
