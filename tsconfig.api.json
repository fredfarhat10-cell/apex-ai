{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/api.tsbuildinfo"
  },
  "include": ["api", "src/lib/reframeShared.ts"]
}
